APP_NAME=marketmind-pytrends
APP_ENV=local
# Read by docker-compose.yml only (the host port it publishes); the app itself
# always listens on 8000.
APP_PORT=8000

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketmind_pytrends
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

# Language sent to Google Ads when the request does not name one.
DEFAULT_HL=en-US
# DataForSEO retries: attempts, and the first wait in seconds (doubled per
# attempt, with jitter, capped at 60 s) on 408 / 429 / 5xx / timeouts / network
# errors / 5xxxx task codes. Same policy in every collector (app/utils/retry.py).
DEFAULT_RETRIES=5
DEFAULT_BACKOFF=2

# --- DataForSEO (the only source since migration 007, 2026-07-15) ---
# Login and API password come from your DataForSEO dashboard (the API password
# is NOT your account login password). Sandbox defaults to true in code: same
# auth, mock data, never billed. Every deployment runs with false.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USE_SANDBOX=true

LOG_LEVEL=INFO
