APP_NAME=marketmind-pytrends
APP_ENV=local
APP_PORT=8000

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketmind_pytrends
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

DEFAULT_HL=en-US
DEFAULT_TZ=0
DEFAULT_TIMEFRAME=today 12-m
DEFAULT_TIMEOUT=30
DEFAULT_RETRIES=3
DEFAULT_BACKOFF=2

# --- DataForSEO fallback (2026-07-08) ---
# Only used after PyTrends' own retries (TRENDS_RATE_LIMIT_* in
# app/core/config.py) are exhausted. Empty login/password = fallback
# disabled, PyTrends errors propagate exactly as before this existed.
# Login/API password come from your DataForSEO dashboard (API password is
# NOT your account login password). Sandbox defaults to true: same auth,
# mock data, never billed — switch to false only once you've validated
# the pipeline end-to-end.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USE_SANDBOX=true

LOG_LEVEL=INFO
